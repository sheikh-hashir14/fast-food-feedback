    {
      "parameters": {
        "jsCode": "// Server-side validation. The browser checks the form too, but a bot can\n// skip the browser entirely, so every rule is repeated here.\nconst body = $input.first().json.body || {};\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\n\nconst itemId = Number(body.item_id);\nconst rating = Number(body.rating);\nconst name = text(body.reviewer_name);\nconst review = text(body.review_text);\nconst deviceId = text(body.device_id);\nconst errors = [];\n\n// Honeypot: a real student never sees or fills this field.\nif (text(body.website) !== '') {\n  return [{ json: { valid: false, error: 'Submission rejected.' } }];\n}\n\nif (!Number.isInteger(itemId) || itemId <= 0) errors.push('A valid item is required.');\nif (!Number.isInteger(rating) || rating < 1 || rating > 5) errors.push('Rating must be a whole number from 1 to 5.');\nif (name.length < 2 || name.length > 30) errors.push('Name must be 2-30 characters.');\nif (review.length > 300) errors.push('Review must be 300 characters or fewer.');\nif (!/^[A-Za-z0-9-]{8,64}$/.test(deviceId)) errors.push('device_id is missing or invalid.');\n\nif (errors.length > 0) {\n  return [{ json: { valid: false, error: errors.join(' ') } }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    error: null,\n    review: {\n      item_id: itemId,\n      rating,\n      reviewer_name: name,\n      review_text: review,\n      device_id: deviceId,\n    },\n  },\n}];"
      },
      "id": "validate",
      "name": "Validate review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 900]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "IF valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 900]
    },
